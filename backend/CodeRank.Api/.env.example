# Reference only: ASP.NET Core does not automatically read .env files.
# Set this environment variable in the process launching the API,
# or use dotnet user-secrets for local development.
ConnectionStrings__DefaultConnection="<SQL_SERVER_CONNECTION_STRING>"

# Non-secret JWT settings (matching appsettings.json).
Jwt__Issuer=CodeRank
Jwt__Audience=CodeRank.Client
Jwt__AccessTokenMinutes=15
# Provide a Base64-encoded cryptographically random key of at least 32 bytes locally.
# No signing key is committed; an empty value prevents normal HTTP startup.
Jwt__SigningKey=
