abi <abi/4.0>,
#include <tunables/global>

profile coderank-judge-sandbox flags=(mediate_deleted) {
  #include <abstractions/base>

  # Only this service identity may create the user namespaces. It has no host capabilities.
  userns create,
  capability sys_admin,
  capability sys_chroot,
  capability setuid,
  capability setgid,
  capability setpcap,
  capability dac_override,
  mount,
  umount,
  pivot_root,

  signal (send, receive) peer=coderank-judge-sandbox,
  signal (receive) peer=unconfined,
  ptrace (read, readby) peer=coderank-judge-sandbox,
  network unix stream,
  # NsJail's parent opens NETLINK_ROUTE during namespace setup. Seccomp denies sockets in the jail.
  network netlink raw,
  deny network inet,
  deny network inet6,

  / r,
  /opt/ r,
  /opt/coderank-judge-sandbox/ r,
  /opt/coderank-judge-sandbox/** r,
  /opt/coderank-judge-sandbox/bin/{nsjail,coderank-sandbox-entry} mrix,
  /opt/coderank-judge-sandbox/app/** mr,
  /opt/coderank-judge-sandbox/{compile-root,runtime-root}/usr/lib/** mr,
  /opt/coderank-judge-sandbox/{compile-root,runtime-root}/job/coderank-sandbox-entry mrix,
  /usr/bin/dotnet mrix,
  /{usr/share,usr/lib}/dotnet/dotnet mrix,
  /{usr/share,usr/lib}/dotnet/** mr,
  /usr/bin/{g++,g++-*,x86_64-linux-gnu-g++-*,as,x86_64-linux-gnu-as,ld,ld.bfd,x86_64-linux-gnu-ld*,python3,python3.12} mrix,
  /usr/lib/gcc/** mrix,
  # Noble GCC 13 runs these helpers from libexec inside the compile rootfs.
  /usr/libexec/gcc/x86_64-linux-gnu/13/{cc1plus,collect2} mrix,
  /usr/libexec/gcc/x86_64-linux-gnu/13/liblto_plugin.so mr,
  /usr/lib/** mr,
  /usr/include/** r,
  /usr/{bin,lib,include}/ r,
  /etc/{passwd,group,nsswitch.conf,ld.so.cache,os-release} r,
  /usr/lib/os-release r,
  /job/ r,
  /job/{Main.cpp,Main.py} r,
  /job/{coderank-sandbox-entry,program} mrix,
  /dev/null rw,
  /tmp/ rw,
  /tmp/** rwk,
  /run/coderank-judge-sandbox/ rw,
  /run/coderank-judge-sandbox/** rwk,
  /run/coderank-judge-sandbox/job-*/payload mrix,
  /run/coderank-judge-sandbox-worker/ rw,
  /run/coderank-judge-sandbox-worker/** rwk,
  /run/coderank-judge-ipc/sandbox.sock rw,

  /proc/ r,
  /proc/{self,[0-9]*}/{attr/current,status,cgroup,mountinfo,maps,stat,cmdline,syscall} r,
  /proc/{self,[0-9]*}/{uid_map,gid_map,setgroups} rw,
  /proc/{self,[0-9]*}/fd/ r,
  /proc/sys/kernel/apparmor_restrict_unprivileged_userns r,
  /sys/fs/cgroup/ r,
  /sys/fs/cgroup/system.slice/ r,
  /sys/fs/cgroup/system.slice/coderank-judge-sandbox-{smoke,worker}.service/ rw,
  /sys/fs/cgroup/system.slice/coderank-judge-sandbox-{smoke,worker}.service/{cgroup.controllers,cgroup.type} r,
  /sys/fs/cgroup/system.slice/coderank-judge-sandbox-{smoke,worker}.service/{cgroup.procs,cgroup.subtree_control} rw,
  /sys/fs/cgroup/system.slice/coderank-judge-sandbox-{smoke,worker}.service/supervisor/ r,
  /sys/fs/cgroup/system.slice/coderank-judge-sandbox-{smoke,worker}.service/supervisor/cgroup.procs r,
  /sys/fs/cgroup/system.slice/coderank-judge-sandbox-{smoke,worker}.service/job-*/ rw,
  /sys/fs/cgroup/system.slice/coderank-judge-sandbox-{smoke,worker}.service/job-*/{cgroup.kill,cgroup.procs,cpu.max,memory.max,memory.oom.group,memory.swap.max,pids.max} rw,
  /sys/fs/cgroup/system.slice/coderank-judge-sandbox-{smoke,worker}.service/job-*/{cgroup.events,memory.events} r,
}
