diff --git a/mnt_legacy.cc b/mnt_legacy.cc
index 058034a..b97374b 100644
--- a/mnt_legacy.cc
+++ b/mnt_legacy.cc
@@ -235,19 +235,17 @@ static bool mountSinglePoint(mount_t* mpt, const char* newroot, const char* tmpd
 	return true;
 }
 
-static unsigned long computeRemountFlags(const mount_t& mpt, const struct statvfs& vfs) {
+static unsigned long computeRemountFlags(unsigned long requested_flags, const struct statvfs& vfs) {
 	struct {
 		const unsigned long mount_flag;
 		const unsigned long vfs_flag;
 	} static const mountPairs[] = {
+	    {MS_RDONLY, ST_RDONLY},
 	    {MS_NOSUID, ST_NOSUID},
 	    {MS_NODEV, ST_NODEV},
 	    {MS_NOEXEC, ST_NOEXEC},
 	    {MS_SYNCHRONOUS, ST_SYNCHRONOUS},
 	    {MS_MANDLOCK, ST_MANDLOCK},
-	    {MS_NOATIME, ST_NOATIME},
-	    {MS_NODIRATIME, ST_NODIRATIME},
-	    {MS_RELATIME, ST_RELATIME},
 	    {MS_NOSYMFOLLOW, ST_NOSYMFOLLOW},
 	};
 
@@ -255,7 +253,8 @@ static unsigned long computeRemountFlags(const mount_t& mpt, const struct statvf
 	    MS_LAZYTIME | MS_MANDLOCK | MS_NOATIME | MS_NODEV | MS_NODIRATIME | MS_NOEXEC |
 	    MS_NOSUID | MS_RELATIME | MS_RDONLY | MS_SYNCHRONOUS | MS_NOSYMFOLLOW;
 
-	unsigned long flags = MS_REMOUNT | MS_BIND | (mpt.flags & per_mountpoint_flags);
+	/* Linux preserves the existing atime mode when none is requested on a remount. */
+	unsigned long flags = MS_REMOUNT | MS_BIND | (requested_flags & per_mountpoint_flags);
 	for (const auto& i : mountPairs) {
 		if (vfs.f_flag & i.vfs_flag) {
 			flags |= i.mount_flag;
@@ -275,7 +274,7 @@ bool remountPt(mnt::mount_t& mpt) {
 		return false;
 	}
 
-	unsigned long flags = computeRemountFlags(mpt, vfs);
+	unsigned long flags = computeRemountFlags(mpt.flags, vfs);
 	LOG_D("Remounting '%s' with flags: %s", mpt.dst.c_str(), mnt::flagsToStr(flags).c_str());
 
 	if (mount(mpt.dst.c_str(), mpt.dst.c_str(), nullptr, flags, nullptr) == -1) {
@@ -333,9 +332,17 @@ std::unique_ptr<std::string> buildMountTree(nsj_t* nsj, std::vector<mnt::mount_t
 	}
 
 	if (!nsj->is_root_rw) {
-		if (mount(destdir->c_str(), destdir->c_str(), nullptr,
-			MS_REMOUNT | MS_BIND | MS_RDONLY, nullptr) == -1) {
-			PLOG_E("mount('%s', MS_REMOUNT|MS_BIND|MS_RDONLY)", destdir->c_str());
+		struct statvfs vfs;
+		if (TEMP_FAILURE_RETRY(statvfs(destdir->c_str(), &vfs)) == -1) {
+			PLOG_E("statvfs('%s')", destdir->c_str());
+			return nullptr;
+		}
+
+		/* A bind over the staging mount can carry flags locked when the namespace was cloned. */
+		const unsigned long flags = computeRemountFlags(MS_RDONLY, vfs);
+		const auto flags_text = mnt::flagsToStr(flags);
+		if (mount(destdir->c_str(), destdir->c_str(), nullptr, flags, nullptr) == -1) {
+			PLOG_E("mount('%s', flags=%s)", destdir->c_str(), flags_text.c_str());
 			return nullptr;
 		}
 	}
