[Unit]
Description=CodeRank Judge local sandbox socket
ConditionArchitecture=x86-64

[Socket]
ListenStream=/run/coderank-judge-ipc/sandbox.sock
FileDescriptorName=judge-sandbox
SocketUser=root
SocketGroup=coderank-worker
SocketMode=0660
DirectoryMode=0755
Backlog=4
RemoveOnStop=yes
Accept=no

[Install]
WantedBy=sockets.target
